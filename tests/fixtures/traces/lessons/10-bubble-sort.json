  "stdout": "[1, 2, 3, 4, 5]\n",
  "source": "def bubble_sort(nums):\n    n = len(nums)\n    for i in range(n):\n        for j in range(n - i - 1):\n            if nums[j] > nums[j + 1]:\n                nums[j], nums[j + 1] = nums[j + 1], nums[j]\n    return nums\n\nnums = [5, 2, 4, 1, 3]\nprint(bubble_sort(nums))\n",
